# Maintainer: 9M2PJU <9m2pju@gmail.com>
# Contributor: Dominik Schwimmbeck

pkgname=horcom
pkgver=0.1.0
pkgrel=1
pkgdesc="Complete desktop astrology program and chart calculator (C++ rewrite of Robert Rettig's HORCOM)"
arch=('x86_64')
url="https://github.com/horcom-rr/HORCOM"
license=('GPL-3.0-or-later')
depends=('qt6-base' 'qt6-svg')
makedepends=('cmake' 'qt6-tools')
source=("$pkgname-$pkgver.tar.gz::https://github.com/horcom-rr/HORCOM/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "HORCOM-$pkgver"
  cmake -B build -S . \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

check() {
  cd "HORCOM-$pkgver"
  ctest --test-dir build --output-on-failure
}

package() {
  cd "HORCOM-$pkgver"
  DESTDIR="$pkgdir" cmake --install build
}
